# Database Configuration
# Get your connection string from Neon: https://neon.tech
DATABASE_URL="postgresql://user:password@host/database"

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="waitlist@ansipress.com"

# Admin Email (receives notifications)
ADMIN_EMAIL="admin@ansipress.com"

# Application URL
# For local development: http://localhost:3000
# For production: https://ansipress.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication
# Use bcrypt to hash the password: https://bcrypt-generator.com/
# Or use a plain password for development only
ADMIN_PASSWORD="your_secure_admin_password_here"

# Admin API Key (for API route authentication)
# Generate a secure random key: openssl rand -hex 32
ADMIN_API_KEY="your_secure_api_key_here"

# Admin Cookie Secret (for JWT signing)
# Generate a secure random key: openssl rand -hex 32
ADMIN_COOKIE_SECRET="your_secure_cookie_secret_here"

# Cloudflare Turnstile (Bot Protection)
# Get these from: https://dash.cloudflare.com/?to=/:account/turnstile
#
# For PRODUCTION: Use your real keys from Cloudflare Dashboard
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_real_site_key_here"
# TURNSTILE_SECRET_KEY="your_real_secret_key_here"
#
# For LOCAL TESTING: Use Cloudflare's test keys below
# ──────────────────────────────────────────────────────
# Test keys that ALWAYS PASS (visible widget):
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
#
# Test keys that ALWAYS PASS (invisible widget):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000BB"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
#
# Test keys that ALWAYS FAIL (for testing error handling):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="2x00000000000000000000AB"
# TURNSTILE_SECRET_KEY="2x0000000000000000000000000000000AB"
