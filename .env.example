# Database Configuration
# Get your connection string from Neon: https://neon.tech
DATABASE_URL="postgresql://user:password@host/database"

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="waitlist@ansipress.com"

# Admin Email (receives notifications)
ADMIN_EMAIL="admin@ansipress.com"

# Application URL
# For local development: http://localhost:3000
# For production: https://ansipress.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication
# Use bcrypt to hash the password: https://bcrypt-generator.com/
# Or use a plain password for development only
ADMIN_PASSWORD="your_secure_admin_password_here"

# Admin API Key (for API route authentication)
# Generate a secure random key: openssl rand -hex 32
ADMIN_API_KEY="your_secure_api_key_here"

# Admin Cookie Secret (for JWT signing)
# Generate a secure random key: openssl rand -hex 32
ADMIN_COOKIE_SECRET="your_secure_cookie_secret_here"
